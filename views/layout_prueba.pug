// views/layout.pug
// Plantilla base para todas las páginas.
doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{title || 'Aplicación de Sesiones'}
    
    // --- Carga de Bootstrap CSS (sustituye a Tailwind CSS si no lo quieres) ---
    link(rel='stylesheet', href='https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css')
    
    // --- Tus estilos personalizados de layout (los que tenías en layout.pug) ---
    // NOTA: Algunas de estas clases (como .container, .dashboard-button) podrían colisionar
    // o ser redundantes si Bootstrap ya tiene equivalentes. Podrías revisar esto.
    style.
      body { font-family: 'Inter', sans-serif; background-color: #f0f4f8; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
      /* El .container de Bootstrap tiene su propio ancho. Revisa si necesitas esto: */
      .custom-container { background-color: #ffffff; padding: 2.5rem; border-radius: 0.75rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); width: 100%; max-width: 28rem; }
      input[type="text"], input[type="password"], input[type="email"] { width: 100%; padding: 0.75rem; margin-bottom: 1rem; border: 1px solid #cbd5e0; border-radius: 0.375rem; box-sizing: border-box; }
      /* Los botones ya estarán estilizados por Bootstrap. Revisa si estos son necesarios: */
      .btn-custom-primary { width: 100%; padding: 0.75rem; background-color: #4f46e5; color: white; border: none; border-radius: 0.375rem; cursor: pointer; font-size: 1rem; font-weight: 600; transition: background-color 0.2s ease-in-out; }
      .btn-custom-primary:hover { background-color: #4338ca; }
      /* Este .dashboard-button ya lo manejas con clases de Bootstrap ahora, probablemente ya no lo necesites */
      /* .dashboard-button { padding: 0.75rem 1.5rem; background-color: #dc2626; color: white; border: none; border-radius: 0.375rem; cursor: pointer; font-size: 1rem; font-weight: 600; transition: background-color 0.2s ease-in-out; }
      .dashboard-button:hover { background-color: #b91c1c; } */
      .error-message { color: #dc3545; margin-bottom: 1rem; text-align: center; } /* Usar color de Bootstrap */
      .success-message { color: #28a745; margin-bottom: 1rem; text-align: center; } /* Usar color de Bootstrap */
      .link-text { text-align: center; margin-top: 1rem; }
      .link-text a { color: #007bff; text-decoration: none; } /* Usar color de Bootstrap */
      .link-text a:hover { text-decoration: underline; }
    
    // --- Bloque para estilos adicionales de cada página ---
    block styles

  body
    // Aquí puedes añadir una barra de navegación de Bootstrap si tu app es más grande
    // Por ahora, solo el contenido central
    block content

    // --- Carga de Bootstrap JS y otros scripts (al final del body es lo ideal) ---
    script(src='/socket.io/socket.io.js')
    script(src='https://code.jquery.com/jquery-3.5.1.slim.min.js') // jQuery (necesario para Bootstrap JS)
    script(src='https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js') // Popper.js (necesario para Bootstrap JS)
    script(src='https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js') // Bootstrap JS

    // --- Bloque para scripts adicionales de cada página (como Socket.IO) ---
    block scripts