.modal.fade#albumViewerModal(tabindex="-1", aria-labelledby="albumViewerModalLabel", aria-hidden="true")
    .modal-dialog.modal-xl.modal-dialog-centered
        .modal-content.bg-dark
            .modal-header.border-0.pb-0
                h5.modal-title.text-white#albumViewerModalLabel
                .d-flex.align-items-center
                    button.btn.btn-outline-light.me-2#fullscreenToggleBtn(type="button", title="Pantalla Completa")
                        i.bi.bi-arrows-fullscreen
                    button.btn-close.btn-close-white(type="button", data-bs-dismiss="modal", aria-label="Close")
            .modal-body.p-5.d-flex.flex-column
                .carousel-container.flex-grow-1.d-flex.flex-column.justify-content-center.align-items-center#carouselContainer
                    #modalCarousel.carousel.slide(data-bs-ride="carousel")                                                   

                        .carousel-inner#carouselInner
                            
                        button.carousel-control-prev(type="button", data-bs-target="#modalCarousel", data-bs-slide="prev")
                            span.carousel-control-prev-icon(aria-hidden="true")
                            span.visually-hidden Previous
                        button.carousel-control-next(type="button", data-bs-target="#modalCarousel", data-bs-slide="next")
                            span.carousel-control-next-icon(aria-hidden="true")
                            span.visually-hidden Next