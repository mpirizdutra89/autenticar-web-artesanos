// views/partials/settings_offcanvas.pug
// Offcanvas para "Ajustes de Cuenta"
.offcanvas.offcanvas-end(tabindex="-1", id="settingsOffcanvas", aria-labelledby="settingsOffcanvasLabel")
    .offcanvas-header
        h5.offcanvas-title#settingsOffcanvasLabel
            i.bi.bi-gear-fill.me-2
            | Ajustes de Cuenta
        button.btn-close.text-reset.btn-close-white(type="button", data-bs-dismiss="offcanvas", aria-label="Close")
    .offcanvas-body
        h6.text-section-title.mb-3 Seguridad y Acceso
        .card-settings.p-3
            .mb-3
                label.form-label-offcanvas(for="currentPassword") Contraseña Actual
                input.form-control#currentPassword(type="password")
            .mb-3
                label.form-label-offcanvas(for="newPassword") Nueva Contraseña
                input.form-control#newPassword(type="password")
            .mb-3
                label.form-label-offcanvas(for="confirmPassword") Confirmar Nueva Contraseña
                input.form-control#confirmPassword(type="password")
            button.btn.btn-custom-primary.w-100 Cambiar Contraseña

        h6.text-section-title.mb-3.mt-4 Preferencias de Notificación
        .card-settings.p-3
            .form-check.form-switch.mb-2
                input.form-check-input#emailNotifications(type="checkbox", checked)
                label.form-check-label(for="emailNotifications") Notificaciones por Email
            .form-check.form-switch.mb-2
                input.form-check-input#pushNotifications(type="checkbox", checked)
                label.form-check-label(for="pushNotifications") Notificaciones Push (en el sitio)
            .form-check.form-switch
                input.form-check-input#marketingEmails(type="checkbox")
                label.form-check-label(for="marketingEmails") Recibir ofertas y noticias

        h6.text-section-title.mb-3.mt-4 Privacidad
        .card-settings.p-3
            .form-check.form-switch.mb-2
                input.form-check-input#publicProfile(type="checkbox", checked)
                label.form-check-label(for="publicProfile") Mi perfil es público
            .form-check.form-switch
                input.form-check-input#allowMessages(type="checkbox")
                label.form-check-label(for="allowMessages") Permitir que otros artistas me envíen mensajes

        h6.text-section-title.mb-3.mt-4.text-danger Zona de Peligro
        .card-settings.p-3.border-danger
            button.btn.btn-outline-danger.w-100(type="button")
                i.bi.bi-person-x.me-2
                | Eliminar Cuenta
            p.text-muted.text-center.mt-2.small Esta acción es irreversible.

        .d-grid.gap-2.mt-4
            button.btn.btn-custom-primary(type="button") Guardar Ajustes