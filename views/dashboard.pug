extends layout
block content
  .container(style="max-width: 32rem; text-align: center;")
      h2.text-3xl.font-bold.text-gray-800.mb-4 Bienvenido al Dashboard, #{username}!
      p.text-gray-600.mb-8 Esta es una página protegida a la que solo puedes acceder si has iniciado sesión.
      form(action="/logout", method="POST")
        button.dashboard-button(type="submit") Cerrar Sesión
