doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    if title
      title #{title}
    else 
      title Artesanos
    
    link(rel="shortcut icon", href="/img/icon/favicon.png", type="image/x-icon")
    link(href="/bootstrap/css/bootstrap.min.css", rel="stylesheet")
    link(rel="stylesheet", href="/bootstrap-icons/bootstrap-icons.min.css")
    link(rel="stylesheet", href="/css/style.css") 
    
    
  body
    nav.navbar.navbar-expand-lg.sticky-top.navbar-custom
      .container-fluid
        a.navbar-brand(href="/album") Artesanos
        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#loggedInNavbar", aria-controls="loggedInNavbar", aria-expanded="false", aria-label="Toggle navigation")
          span.navbar-toggler-icon.text-bg-light
        .collapse.navbar-collapse#loggedInNavbar.justify-content-between
          .d-flex.align-items-center.search-form
            form.d-flex.me-3.flex-grow-1
              input.form-control.flex-grow-1.me-2(type="search", placeholder="Buscar álbumes, obras...", aria-label="Search")
              button.btn.btn-outline-light(type="submit")
                i.bi.bi-search
          .d-flex.align-items-center#Notificacion-perfil-usuario
            if user
                if !panel_notificacion
                  
                      .dropdown.me-3
                        a.nav-link.position-relative(href="#", id="notificationsDropdown", role="button", data-bs-toggle="dropdown", aria-expanded="false")
                          i.bi.bi-bell-fill.h4
                          span.badge.bg-danger.rounded-pill.position-absolute.notification-badge#notification-count 
                        ul#notification-list-container.dropdown-menu.dropdown-menu-end.notifications-dropdown-menu(aria-labelledby="notificationsDropdown")
                            h6.dropdown-header Notificaciones
                            li
                              hr.dropdown-divider
                            div#no-notifications(style="display: none; padding: 10px; text-align: center; color: #6c757d;") No hay notificaciones.
                            div#listaNotificaciones

                // Menú desplegable del perfil de usuario
                .dropdown
                  a.nav-link.dropdown-toggle(href="#", id="navbarDropdown", role="button", data-bs-toggle="dropdown", aria-expanded="false")
                    img.profile-pic.me-1(src="/img/perfil_default/default.png", alt="Foto de Perfil de Usuario")
                    | ArtistaEjemplo
                  ul.dropdown-menu.dropdown-menu-end(aria-labelledby="navbarDropdown")
                    li
                      a.dropdown-item(href="#", data-bs-toggle="offcanvas", data-bs-target="#profileOffcanvas") Mi Perfil
                    li
                      a.dropdown-item(href="#", data-bs-toggle="offcanvas", data-bs-target="#settingsOffcanvas") Ajustes de Cuenta
                    li
                      hr.dropdown-divider
                    li
                      form(action="/usuario/logout", method="POST")
                        button.dropdown-item(type="submit") Cerrar Sesión
                      //a.dropdown-item(href="#") Cerrar Sesión

            else
              button.btn.btn-outline-custom-primary.me-2(type="button", data-bs-toggle="modal", data-bs-target="#loginModal")
                | Iniciar Sesión
              button.btn.btn-outline-custom-primary(type="button", data-bs-toggle="modal", data-bs-target="#registerModal")
                | Registrarse
    
    main.container.my-4
            block content

    include ./partials/manage_publico_modal.pug
    if user
      include ./partials/profile_offcanvas.pug
      include ./partials/settings_offcanvas.pug    
    
      // Tu contenido HTML, navegación, etc.

    // Scripts al final del body para un mejor rendimiento de carga

    // LIBRARIES JAVASCRIPT REQUERIDAS PRIMERO
    script(src="/bootstrap/js/bootstrap.bundle.min.js") // 1. Bootstrap JS (para componentes)
    script(src='/socket.io/socket.io.js')               // 2. Socket.IO Client JS (para 'io()' global)

    // INYECCIÓN DE DATOS DINÁMICOS AL CLIENTE
    // Esto se ejecuta ANTES de cualquier script externo que dependa de 'notificaciones'
    script.
      window.initialNotificationsData = !{JSON.stringify(notificaciones || [])};

    // TUS SCRIPTS PERSONALIZADOS (que dependen de las librerías anteriores y de initialNotificationsData)
    // Usamos 'block append scripts' para que las vistas que extienden este layout puedan añadir sus propios scripts AQUÍ.
    // Esto asegura que 'notificaciones.js' se cargue antes que cualquier script específico de una vista.
    script(src='/js/notificaciones.js' type="module") // Tu script de notificaciones
    script(src="/js/global.js" type="module")         // Tu script global

    // Este 'block scripts' se puede usar en tus vistas que extienden el layout
    // para añadir scripts específicos de esa vista, y se cargarán DESPUÉS
    // de notificaciones.js y global.js.
    block scripts

