extends layout_prueba

block content
  .container
    h2.text-3xl.font-bold.text-center.text-gray-800.mb-6 Registrarse
    if error
      p.error-message= error
    - let pref=""
    if prefijo 
        - pref=prefijo + "register"
    form(action=pref, method="POST")
        .mb-4
          label.block.text-gray-700.text-sm.font-bold.mb-2(for="nombre") Nombre:
          input(type="text", id="nombre", name="nombre", placeholder="Tu nombre", required)
        .mb-4
          label.block.text-gray-700.text-sm.font-bold.mb-2(for="apellido") Apellido:
          input(type="text", id="apellido", name="apellido", placeholder="Tu apellido", required)
        .mb-4
          label.block.text-gray-700.text-sm.font-bold.mb-2(for="email") Correo Electrónico:
          input(type="email", id="email", name="email", placeholder="tu@ejemplo.com", required)
        .mb-6
          label.block.text-gray-700.text-sm.font-bold.mb-2(for="password") Contraseña:
          input(type="password", id="password", name="password", placeholder="Crea una contraseña", required)
        button(type="submit") Registrarse
    .link-text
      p ¿Ya tienes una cuenta? 
        a(href="/") Inicia sesión aquí