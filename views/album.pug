extends layout
block content
      .tab-pane.fade.show.active#albums(role="tabpanel", aria-labelledby="albums-tab")
        .d-flex.justify-content-between.align-items-center.mb-4
          h3.mb-0.text-section-title Gestiona tus Álbumes Propios
          button.btn.btn-custom-primary(type="button", data-bs-toggle="modal", data-bs-target="#createAlbumModal")
            i.bi.bi-plus-lg.me-2
            | Crear Nuevo Álbum
        .row.row-cols-1.row-cols-md-2.row-cols-lg-3.g-4
          // Ejemplo de Álbum del Usuario
          .col
            .card.h-100.shadow-sm
              img.card-img-top.card-img-top-fit(src="/img/1.jpg", alt="Portada de Álbum")
              .card-body
                h5.card-title Mi Colección Urbana
                p.card-text.text-muted.mb-2
                  small 5 Obras | Última actualización: 1 semana
                p.card-text Una serie de fotografías que capturan la vida y energía de la ciudad.
                .d-flex.justify-content-between.align-items-center.mt-3
                  button.btn.btn-sm.btn-outline-custom-primary.me-2(type="button", data-bs-toggle="modal", data-bs-target="#albumViewerModal", data-album-id="urbanCollection") Ver Álbum
                  div
                    button.btn.btn-sm.btn-secondary.me-2(data-bs-toggle="modal", data-bs-target="#manageAlbumWorksModal", data-album-title="Mi Colección Urbana", data-album-id="urbanCollection")
                      i.bi.bi-images
                      |  Administrar Obras
                    button.btn.btn-sm.btn-info.text-white.me-2(data-bs-toggle="modal", data-bs-target="#createAlbumModal", title="Editar Álbum")
                      i.bi.bi-pencil
                    button.btn.btn-sm.btn-danger(title="Eliminar Álbum")
                      i.bi.bi-trash
          .col
            .card.h-100.shadow-sm
              img.card-img-top.card-img-top-fit(src="/img/4.jpg", alt="Portada de Álbum")
              .card-body
                h5.card-title Retratos en la Naturaleza
                p.card-text.text-muted.mb-2
                  small 8 Obras | Última actualización: 3 días
                p.card-text Explorando la conexión entre el ser humano y el entorno natural a través del retrato.
                .d-flex.justify-content-between.align-items-center.mt-3
                  button.btn.btn-sm.btn-outline-custom-primary.me-2(type="button", data-bs-toggle="modal", data-bs-target="#albumViewerModal", data-album-id="naturePortraits") Ver Álbum
                  div
                    button.btn.btn-sm.btn-secondary.me-2(data-bs-toggle="modal", data-bs-target="#manageAlbumWorksModal", data-album-title="Retratos en la Naturaleza", data-album-id="naturePortraits")
                      i.bi.bi-images
                      |  Administrar Obras
                    button.btn.btn-sm.btn-info.text-white.me-2(data-bs-toggle="modal", data-bs-target="#createAlbumModal", title="Editar Álbum")
                      i.bi.bi-pencil
                    button.btn.btn-sm.btn-danger(title="Eliminar Álbum")
                      i.bi.bi-trash
          .col
            .card.h-100.shadow-sm
              img.card-img-top.card-img-top-fit(src="/img/6.jpg", alt="Portada de Álbum")
              .card-body
                h5.card-title Abstracción y Color
                p.card-text.text-muted.mb-2
                  small 12 Obras | Última actualización: 2 semanas
                p.card-text Pinturas abstractas que juegan con la luz, las formas y una paleta de colores vibrantes.
                .d-flex.justify-content-between.align-items-center.mt-3
                  button.btn.btn-sm.btn-outline-custom-primary.me-2(type="button", data-bs-toggle="modal", data-bs-target="#albumViewerModal", data-album-id="abstractColor") Ver Álbum
                  div
                    button.btn.btn-sm.btn-secondary.me-2(data-bs-toggle="modal", data-bs-target="#manageAlbumWorksModal", data-album-title="Abstracción y Color", data-album-id="abstractColor")
                        i.bi.bi-images
                        |  Administrar Obras
                    button.btn.btn-sm.btn-info.text-white.me-2(data-bs-toggle="modal", data-bs-target="#createAlbumModal", title="Editar Álbum")
                        i.bi.bi-pencil
                    button.btn.btn-sm.btn-danger(title="Eliminar Álbum")
                        i.bi.bi-trash

      include ./partials/create_album_modal.pug
      include ./partials/manage_album_works_modal.pug


block scripts
    script(src="/js/albums.js")
    //block scripts deve estar afuera del block content