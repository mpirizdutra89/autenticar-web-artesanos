extends layout
block styles
  link(rel='stylesheet', href='/css/croppie.min.css')
  style.
        .cropper-container-wrapper {
            /* Clase genérica para ambos croppers */
            width: 300px;
            /* Ancho base */
            height: 300px;
            /* Alto base */
            margin: 20px auto;
            border: 1px solid #ddd;
            background-color: #f8f8f8;
            display: none;
            /* Controlado por JS */
            position: relative;
        }

        /* Ajuste para el cropper de portada (rectangular) */
        #cropperWrapperParentCover {
            width: 600px;
            /* Ancho para portada */
            height: 150px;
            /* Alto para portada (600/4 = 150) */
        }

        /* Estilo para la imagen de perfil recortada */
        #profileImagePreview {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            /* Circular */
            object-fit: cover;
            /*border: 3px solid #007bff;*/
            display: none;
            /* Controlado por JS */
            margin-left: auto;
            margin-right: auto;
        }

        /* Estilo para la imagen de portada recortada */
        #coverImagePreview {
            width: 400px;
            /* Ancho de la vista previa de portada */
            height: 200px;
            /* Alto de la vista previa de portada */
            object-fit: cover;
           /* border: 3px solid #28a745;*/
            /* Borde verde */
            display: none;
            /* Controlado por JS */
            margin-left: auto;
            margin-right: auto;
        }

        /* Centrar textos de previsualización */
        .preview-text {
            text-align: center;
            margin-top: 20px;
            font-size: 1.25rem;
            /* fs-4 en Bootstrap */
            display: none;
            /* Controlado por JS */
        }

        .preview-subtext {
            text-align: center;
            margin-bottom: 20px;
            color: #6c757d;
            /* text-muted en Bootstrap */
            display: none;
            /* Controlado por JS */
        }

        .error-message {
            color: red;
            font-size: 0.9em;
            margin-top: 5px;
            text-align: center;
        }
block content
  #dashboardTabsContent.tab-content
      
      .tab-pane.fade.show.active#albums(role="tabpanel", aria-labelledby="albums-tab")
        .d-flex.justify-content-between.align-items-center.mb-4
          h3.mb-0.text-section-title Gestiona tus Álbumes Propios
          button.btn.btn-custom-primary(type="button", data-bs-toggle="modal", data-bs-target="#createAlbumModal")
            i.bi.bi-plus-lg.me-2
            | Crear Nuevo Álbum
        .row.row-cols-1.row-cols-md-2.row-cols-lg-3.g-4#AlbumContainer          
          
  include ./partials/create_album_modal.pug
  


block scripts
    script( src="/js/funcionesjs/croppie.min.js")
    script(type='module' src="/js/albums.js")