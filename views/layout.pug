doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Artesanos.com - Dashboard
     link(rel="shortcut icon", href="img/icon/favicon.png", type="image/x-icon")
    link(href="/bootstrap/css/bootstrap.min.css", rel="stylesheet")
    link(rel="stylesheet", href="/bootstrap-icons/bootstrap-icons.min.css")
    link(rel="stylesheet", href="/css/style.css") 
  body
    nav.navbar.navbar-expand-lg.sticky-top.navbar-custom
      .container-fluid
        a.navbar-brand(href="/") Artesanos
        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#loggedInNavbar", aria-controls="loggedInNavbar", aria-expanded="false", aria-label="Toggle navigation")
          span.navbar-toggler-icon.text-bg-light
        .collapse.navbar-collapse#loggedInNavbar.justify-content-between
          .d-flex.align-items-center.search-form
            form.d-flex.me-3.flex-grow-1
              input.form-control.flex-grow-1.me-2(type="search", placeholder="Buscar álbumes, obras...", aria-label="Search")
              button.btn.btn-outline-light(type="submit")
                i.bi.bi-search
          .d-flex.align-items-center#Notificacion-perfil-usuario
            
            .dropdown.me-3
              a.nav-link.position-relative(href="#", id="notificationsDropdown", role="button", data-bs-toggle="dropdown", aria-expanded="false")
                i.bi.bi-bell-fill.h4
                span.badge.bg-danger.rounded-pill.position-absolute.notification-badge#nrNotificacion 3
              ul.dropdown-menu.dropdown-menu-end.notifications-dropdown-menu(aria-labelledby="notificationsDropdown")
                h6.dropdown-header Notificaciones
                li
                  hr.dropdown-divider
              
                li
                  a.dropdown-item.d-flex.align-items-center.notifications-dropdown-item(href="#")
                    i.bi.bi-person-plus-fill.text-primary.notification-icon
                    .notification-info.flex-grow-1
                      p.mb-1
                        strong SofiaM
                        |  te ha enviado una solicitud de amistad.
                      .d-flex.justify-content-end.mt-2
                        button.btn.btn-sm.btn-success.me-2 Aceptar
                        button.btn.btn-sm.btn-danger Rechazar
                
                li
                  a.dropdown-item.d-flex.align-items-center.notifications-dropdown-item(href="#")
                    i.bi.bi-chat-text-fill.text-info.notification-icon
                    .notification-info.flex-grow-1 
                      p.mb-1
                        strong RicardoV
                        |  comentó en tu obra "El Silencio Urbano".
                      small.text-muted "Me encanta cómo capturas la soledad..."
                      .text-end.mt-1
                      
                        span.text-warning.cursor-pointer(onclick="window.location.href='#';")
                li
                  hr.dropdown-divider
                li
                  a.dropdown-item.text-center.text-warning(href="#") Ver todas las notificaciones

            // Menú desplegable del perfil de usuario
            .dropdown
              a.nav-link.dropdown-toggle(href="#", id="navbarDropdown", role="button", data-bs-toggle="dropdown", aria-expanded="false")
                img.profile-pic.me-1(src="/img/perfil_default/default.png", alt="Foto de Perfil de Usuario")
                | ArtistaEjemplo
              ul.dropdown-menu.dropdown-menu-end(aria-labelledby="navbarDropdown")
                li
                  a.dropdown-item(href="#", data-bs-toggle="offcanvas", data-bs-target="#profileOffcanvas") Mi Perfil
                li
                  a.dropdown-item(href="#", data-bs-toggle="offcanvas", data-bs-target="#settingsOffcanvas") Ajustes de Cuenta
                li
                  hr.dropdown-divider
                li
                  a.dropdown-item(href="#") Cerrar Sesión

    
    main.container.my-4
        
        h1.display-5.fw-bold.mb-4.text-center.text-section-title.glitch-effect
          | Tu Lienzo Digital. Tu Comunidad
        ul#dashboardTabs.nav.nav-tabs.justify-content-center.mb-4(role="tablist")
              li.nav-item(role="presentation")
                a#albums-tab.nav-link(href="/", class=(activeTab === 'albums' ? 'active' : ''))
                  i.bi.bi-collection-fill.me-2
                  | Mis Álbumes
              li.nav-item(role="presentation")
                a#shared-albums-tab.nav-link(href="./shared-albums", class=(activeTab === 'shared-albums' ? 'active' : ''))
                  i.bi.bi-people-fill.me-2
                  | Álbumes Compartidos
              li.nav-item(role="presentation")
                 a#portfolio-tab.nav-link(href="./portfolio", class=(activeTab === 'portfolio' ? 'active' : ''))
                  i.bi.bi-star-fill.me-2
                  | Mi Portafolio
              li.nav-item(role="presentation")
                 a#stats-tab.nav-link(href="./stats", class=(activeTab === 'stats' ? 'active' : ''))
                  i.bi.bi-graph-up.me-2
                  | Estadísticas
        #dashboardTabsContent.tab-content  
            block content

    include ./partials/profile_offcanvas.pug
    include ./partials/settings_offcanvas.pug
    include ./partials/album_viewer_modal.pug

    
    script(src="/bootstrap/js/bootstrap.bundle.min.js")   
    script(src="/js/global.js")

   
    block scripts