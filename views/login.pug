extends layout
block content
    .container
        h2.text-3xl.font-bold.text-center.text-gray-800.mb-6 Iniciar Sesión
        if error
          h4(style='color:red;')=error
        form(action="/login", method="POST")
            .mb-4
              label.block.text-gray-700.text-sm.font-bold.mb-2(for="email") Correo Electrónico:
              input(type="email", id="email", name="email", placeholder="tu@ejemplo.com", required)
            .mb-6
              label.block.text-gray-700.text-sm.font-bold.mb-2(for="password") Contraseña:
              input(type="password", id="password", name="password", placeholder="Tu contraseña", required)
            
            button(type="submit") Entrar